<Project>
  <!-- Only apply legacy browse-only attachment to the UnrealAA C++ project; avoid affecting Engine .NET rule builds. -->
  <PropertyGroup>
    <AAExternalRoot>$(MSBuildThisFileDirectory)Plugins\AmuletsAndArmorPort\External\AmuletsAndArmor\Source\</AAExternalRoot>
    <AAHostProjectName>UnrealAA</AAHostProjectName>
  </PropertyGroup>

  <!-- Restrict warning suppression to our solution C++ project; do NOT touch AutomationTool or other Engine csproj builds to avoid unintended restore policy side effects. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='$(AAHostProjectName)'">
    <NoWarn>$(NoWarn);NU1701;NU1901;NU1902;NU1903</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1701;NU1901;NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Attach the legacy sources to a single project to avoid duplication in every UE project. 
       Change 'UnrealAA' to another project name if you prefer a different host. -->
  <ItemGroup Condition="'$(MSBuildProjectName)'=='$(AAHostProjectName)'">
    <!-- C/C++ sources (browse-only) -->
    <ClCompile Include="$(AAExternalRoot)**\*.c;$(AAExternalRoot)**\*.cpp">
      <ExcludedFromBuild>true</ExcludedFromBuild>
      <CompileAsManaged>false</CompileAsManaged>
      <Filter>External\AmuletsAndArmor\$([System.String]::Copy('%(RecursiveDir)').TrimEnd('\\'))</Filter>
    </ClCompile>

    <!-- Headers -->
    <ClInclude Include="$(AAExternalRoot)**\*.h;$(AAExternalRoot)**\*.hpp">
      <Filter>External\AmuletsAndArmor\$([System.String]::Copy('%(RecursiveDir)').TrimEnd('\\'))</Filter>
    </ClInclude>

    <!-- Other text-like includes -->
    <None Include="$(AAExternalRoot)**\*.inc;$(AAExternalRoot)**\*.txt">
      <Filter>External\AmuletsAndArmor\$([System.String]::Copy('%(RecursiveDir)').TrimEnd('\\'))</Filter>
    </None>
  </ItemGroup>
</Project>